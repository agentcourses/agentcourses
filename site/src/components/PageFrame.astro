---
/**
 * Starlight's page frame inside the design's centred shell, with its drawer breakpoint. The
 * popover drawer, its focus trapping and the menu toggle are Starlight's own. Above 980 pixels
 * the sidebar docks as the first column of a 1480-pixel grid, beside the page. A page's banner
 * is a strip across the window above the top bar; everything fixed below it starts at
 * `--ac-top`, the banner's measured height plus the bar's.
 * Based on Starlight's PageFrame component, MIT licence, Copyright (c) 2023 Astro contributors.
 */
import { Icon } from '@astrojs/starlight/components';
import MobileMenuToggle from '@astrojs/starlight/components/MobileMenuToggle.astro';

const { hasSidebar, entry } = Astro.locals.starlightRoute;
const banner = entry.data.banner;
---

<div class="page sl-flex">
  {
    banner && (
      <section class="sl-banner ac-banner print:hidden" aria-label="Announcement" data-pagefind-ignore data-banner={banner.content}>
        <div class="ac-banner__text" set:html={banner.content} />
        <button type="button" class="ac-banner__close" aria-label="Dismiss announcement">
          <Icon name="close" />
        </button>
      </section>
    )
  }
  {
    banner && (
      <script is:inline>
        // Runs before the first paint: hides a banner the reader has dismissed and publishes its
        // height, so the top bar and everything fixed beneath it start below the strip.
        (() => {
          const banner = document.currentScript.previousElementSibling;
          const key = 'ac-banner-dismissed';
          const root = document.documentElement;
          const measure = () => root.style.setProperty('--ac-banner-h', banner.hidden ? '0px' : `${banner.offsetHeight}px`);
          try {
            if (localStorage.getItem(key) === banner.dataset.banner) banner.hidden = true;
          } catch {}
          measure();
          new ResizeObserver(measure).observe(banner);
          banner.querySelector('button').addEventListener('click', () => {
            banner.hidden = true;
            try {
              localStorage.setItem(key, banner.dataset.banner);
            } catch {}
            measure();
            document.querySelector('header.header a')?.focus();
          });
        })();
      </script>
    )
  }
  <header class="header"><slot name="header" /></header>
  <div class="shell">
    {
      hasSidebar && (
        <nav class="sidebar print:hidden" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
          <MobileMenuToggle />
          <script>
            // The drawer uses the popover API, so it opens, closes on Escape and returns focus without
            // custom key handling. The rest of the page is made inert while it is open. `beforetoggle`
            // fires synchronously as the state changes; `toggle` is queued and can arrive after the
            // next Tab press, which would let focus reach the page behind the drawer.
            class StarlightSidebarPane extends HTMLElement {
              constructor() {
                super();
                const dockedQuery = matchMedia('(min-width: 981px)');
                const resetPopoverAttribute = () => {
                  this.popover = dockedQuery.matches ? null : 'auto';
                };
                resetPopoverAttribute();
                dockedQuery.addEventListener('change', () => resetPopoverAttribute());
                this.addEventListener('beforetoggle', ({ newState }) => this.trapFocus(newState === 'open'));
              }
              trapFocus(shouldTrap: boolean) {
                document.querySelectorAll<HTMLElement>('.main-frame, .sl-skip-link, .ac-banner').forEach((el) => {
                  el.toggleAttribute('inert', shouldTrap);
                });
              }
            }
            customElements.define('sl-sidebar-pane', StarlightSidebarPane);
          </script>
          <sl-sidebar-pane popover="" id="starlight__sidebar" class="sidebar-pane">
            <div class="sidebar-content sl-flex">
              <slot name="sidebar" />
            </div>
          </sl-sidebar-pane>
        </nav>
      )
    }
    <div class="main-frame"><slot /></div>
  </div>
</div>

<style>
  @layer starlight.core {
    .page {
      flex-direction: column;
      min-height: 100vh;
    }

    .header {
      z-index: var(--sl-z-index-navbar);
      position: fixed;
      inset-inline-start: 0;
      inset-block-start: var(--ac-banner-h);
      width: 100%;
      height: var(--sl-nav-height);
      border-bottom: 1px solid var(--sl-color-hairline-shade);
      padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
      padding-inline-end: var(--sl-nav-pad-x);
      background-color: var(--sl-color-bg-nav);
    }

    :global([data-has-sidebar]) .header {
      padding-inline-end: calc(var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size));
    }

    .sidebar-pane {
      border: unset;
      padding: unset;
      height: unset;
      color: unset;
      position: fixed;
      z-index: var(--sl-z-index-menu);
      inset-block: var(--ac-top) 0;
      inset-inline-start: 0;
      width: min(320px, 86vw);
      background-color: var(--sl-color-bg-sidebar);
      border-inline-end: 1px solid var(--sl-color-hairline-shade);
      box-shadow: var(--shadow-drawer);
      /* The open drawer sits in the top layer; keep its shadow off the top bar. */
      clip-path: inset(0 -80px 0 0);
      overflow-y: auto;
      scrollbar-gutter: stable;
      transform: translateX(-102%);
      transition:
        transform 0.2s ease,
        overlay 0.2s ease allow-discrete,
        display 0.2s ease allow-discrete;
    }
    .sidebar-pane:popover-open {
      transform: none;
    }
    @starting-style {
      .sidebar-pane:popover-open {
        transform: translateX(-102%);
      }
    }
    .sidebar-pane::backdrop {
      inset-block-start: var(--ac-top, var(--sl-nav-height));
      background-color: var(--sl-color-backdrop-overlay);
    }

    .sidebar-content {
      height: 100%;
      min-height: max-content;
      padding: 20px 14px 40px var(--sl-sidebar-pad-x);
      flex-direction: column;
      gap: 1rem;
    }

    /* The shell holds the columns below the fixed top bar, centred at every width. */
    .shell {
      width: 100%;
      max-width: var(--shell-w);
      margin-inline: auto;
      padding-top: var(--ac-top);
      padding-inline: var(--gutter);
    }

    .main-frame {
      min-width: 0;
      padding-top: var(--sl-mobile-toc-height);
    }

    @media (min-width: 981px) {
      :global([data-has-sidebar]) .header {
        padding-inline-end: var(--sl-nav-pad-x);
      }
      :global([data-has-sidebar]) .shell {
        display: grid;
        grid-template-columns: var(--side-w) minmax(0, 1fr);
        column-gap: var(--col-gap);
      }
      .sidebar {
        position: sticky;
        top: var(--ac-top);
        align-self: start;
        height: calc(100vh - var(--ac-top));
      }
      .sidebar-pane {
        display: block;
        position: static;
        width: auto;
        height: 100%;
        border-inline-end: 0;
        background-color: transparent;
        transform: none;
        transition: none;
        box-shadow: none;
        clip-path: none;
      }
      .sidebar-content {
        padding: 28px 8px 40px 0;
      }
      .sidebar-content::after {
        content: '';
        padding-bottom: 1px;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-pane {
      transition: none;
    }
  }
</style>
