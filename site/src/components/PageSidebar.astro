---
/**
 * Starlight's page sidebar with the design's contents breakpoint: the column shows above
 * 1240 pixels, and Starlight's folded "On this page" control is used at 1240 pixels and below.
 * Based on Starlight's PageSidebar component, MIT licence, Copyright (c) 2023 Astro contributors.
 */
import MobileTableOfContents from '@astrojs/starlight/components/MobileTableOfContents.astro';
import TableOfContents from '@astrojs/starlight/components/TableOfContents.astro';
---

{
  Astro.locals.starlightRoute.toc && (
    <>
      <div class="toc-folded">
        <MobileTableOfContents />
      </div>
      <div class="right-sidebar-panel">
        <div class="sl-container">
          <TableOfContents />
        </div>
      </div>
    </>
  )
}

<style>
  @layer starlight.core {
    .right-sidebar-panel {
      display: none;
      padding: 44px 0 40px;
    }
    .right-sidebar-panel :global(h2) {
      color: var(--sl-color-white);
      font-size: var(--sl-text-h5);
      font-weight: 600;
      line-height: var(--sl-line-height-headings);
      margin-bottom: 0.5rem;
    }
    .right-sidebar-panel :global(:where(a)) {
      display: block;
      font-size: var(--sl-text-xs);
      text-decoration: none;
      color: var(--sl-color-gray-3);
      overflow-wrap: anywhere;
    }
    .right-sidebar-panel :global(:where(a):hover) {
      color: var(--sl-color-white);
    }
    @media (min-width: 1241px) {
      .toc-folded {
        display: none;
      }
      .right-sidebar-panel {
        display: block;
      }
    }
  }
</style>

<script>
  // Keep Starlight's heading model and controls, but let an explicit fragment take priority
  // over its scroll observer. Both controls must show the same destination, even off screen.
  const syncContents = async () => {
    await Promise.all([customElements.whenDefined('starlight-toc'), customElements.whenDefined('mobile-starlight-toc')]);
    document.querySelectorAll<HTMLElement>('starlight-toc, mobile-starlight-toc').forEach((toc) => {
      const links = [...toc.querySelectorAll<HTMLAnchorElement>('a')];
      const fragmentLink = () => links.find((link) => {
        try { return decodeURIComponent(link.hash) === decodeURIComponent(location.hash); } catch { return false; }
      });
      const select = (link?: HTMLAnchorElement) => {
        links.forEach((item) => item.toggleAttribute('aria-current', false));
        link?.setAttribute('aria-current', 'true');
        Reflect.set(toc, '_current', link ?? null);
        const display = toc.querySelector('.display-current');
        if (display) display.textContent = link?.textContent ?? '';
      };
      if (!Object.hasOwn(toc, 'current')) {
        let prototype = Object.getPrototypeOf(toc);
        while (prototype && !Object.getOwnPropertyDescriptor(prototype, 'current')) prototype = Object.getPrototypeOf(prototype);
        const setter = Object.getOwnPropertyDescriptor(prototype, 'current')?.set;
        Object.defineProperty(toc, 'current', { set(link: HTMLAnchorElement) {
          if (location.hash) select(fragmentLink());
          else setter?.call(toc, link);
        } });
      }
      select(location.hash ? fragmentLink() : links[0]);
    });
  };
  syncContents();
  document.addEventListener('astro:page-load', syncContents);
  window.addEventListener('hashchange', syncContents);
  window.addEventListener('popstate', syncContents);
</script>
