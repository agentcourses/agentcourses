{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentcourses.io/schemas/1.0.0-rc.2/lesson.schema.json",
  "title": "Agent Courses lesson",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "understand",
        "practise",
        "build",
        "demonstrate"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "allOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$(?![\\s\\S])",
                "minLength": 1,
                "maxLength": 64
              },
              {
                "not": {
                  "const": "explain-back"
                }
              }
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "allOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$(?![\\s\\S])",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  {
                    "not": {
                      "const": "explain-back"
                    }
                  }
                ]
              },
              "required": {
                "type": "boolean"
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": true
          }
        ]
      }
    },
    "minutes": {
      "type": "integer",
      "minimum": 1
    },
    "calls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "allOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$(?![\\s\\S])",
                "minLength": 1,
                "maxLength": 64
              },
              {
                "not": {
                  "const": "explain-back"
                }
              }
            ]
          },
          "ask": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "ask"
        ],
        "additionalProperties": true
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "allOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$(?![\\s\\S])",
                "minLength": 1,
                "maxLength": 64
              },
              {
                "not": {
                  "const": "explain-back"
                }
              }
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "by": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$(?![\\s\\S])",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "id",
          "text",
          "by"
        ],
        "additionalProperties": true
      }
    },
    "starter": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$(?![\\s\\S])"
      }
    }
  },
  "required": [
    "title",
    "stage"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "understand"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "maxItems": 0
          },
          "objectives": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "practise",
              "build"
            ]
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "required": [
          "checks"
        ],
        "properties": {
          "checks": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
